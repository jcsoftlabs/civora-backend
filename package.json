{
  "name": "civora",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/api --filter ./apps/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @civora/db generate",
    "db:migrate": "pnpm --filter @civora/db migrate",
    "db:seed": "pnpm --filter @civora/db seed",
    "check:requirements": "node scripts/check-requirements.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^20.14.0",
    "eslint": "^9.12.0",
    "eslint-plugin-svelte": "^3",
    "globals": "^15",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3",
    "svelte": "^5.57",
    "svelte-eslint-parser": "^1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8",
    "vitest": "^2.1.0"
  }
}
