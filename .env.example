# Copier en .env (jamais versionné). Valeurs réelles dans le gestionnaire de secrets.

# Base de données
# DATABASE_URL : rôle civora_app (soumis à RLS). En production, passe par PgBouncer en mode transaction (port 6432).
# DATABASE_URL_MIGRATOR : rôle civora_owner, connexion DIRECTE à Postgres (jamais via PgBouncer : DDL et verrous).
# Ne jamais utiliser le super-utilisateur « postgres » pour l'application : il contourne la RLS.
DATABASE_URL=postgres://civora_app:change-me@localhost:5432/civora
DATABASE_PGBOUNCER=false
# SEC-03 : « require » dès que la base est jointe par le réseau public (proxy Railway, autre hébergeur).
DATABASE_SSL=disable
DATABASE_URL_MIGRATOR=postgres://civora_owner:change-me@localhost:5432/civora
DATABASE_URL_READONLY_BI=postgres://civora_bi:change-me@localhost:5432/civora

# API
API_PORT=4000
API_ALLOWED_ORIGINS=http://localhost:5173
# Protège les empreintes des codes de connexion (32 caractères au moins) : openssl rand -hex 32
AUTH_SECRET=change-me

# Chiffrement des pièces d'identité (clé maîtresse qui chiffre les clés de chaque parti, SEC-02)
# 32 octets en base64 : openssl rand -base64 32. Perdre cette clé rend toutes les pièces illisibles :
# la conserver dans le gestionnaire de secrets, avec une copie de secours hors ligne.
KMS_MASTER_KEY=change-me
KMS_MASTER_KEY_ID=1
# Rotation : l'ancienne clé passe ici (lecture seule) le temps de réenvelopper les clés des partis.
KMS_MASTER_KEY_PREVIOUS=
KMS_MASTER_KEY_PREVIOUS_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=civora-files

# Resend
RESEND_API_KEY=
RESEND_FROM=notifications@example.com

# Paiements (clés de test uniquement en local)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_MODE=sandbox
NATCASH_API_KEY=

# Notifications
FCM_PROJECT_ID=
# Fournisseur SMS : « log » en local, « none » en production tant qu'aucun n'est choisi.
# Le SMS est payant : chaque parti l'active lui-même (parties.otp_channels). E-mail par défaut.
SMS_PROVIDER=log
WHATSAPP_BUSINESS_TOKEN=

# Web
PUBLIC_API_URL=http://localhost:4000
PUBLIC_ROOT_DOMAIN=localhost
