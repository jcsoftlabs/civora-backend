{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile",
    "watchPatterns": ["apps/api/**", "apps/worker/**", "packages/db/**", "packages/shared/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @civora/api start",
    "preDeployCommand": ["pnpm --filter @civora/db exec tsx src/migrate.ts"],
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
